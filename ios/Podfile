# Uncomment this line to define a global platform for your project
platform :ios, '26.0'

unless system('/bin/sh', File.expand_path('../scripts/check_ios_toolchain.sh', __dir__))
  raise 'The selected iOS SDK does not meet this project\'s iPhone Duo build requirements.'
end

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
#   target 'RunnerTests' do
#     inherit! :search_paths
#   end
end

post_install do |installer|
  sdk_version = `xcrun --sdk iphoneos --show-sdk-version`.strip
  duo_sdk = Gem::Version.new(sdk_version) >= Gem::Version.new('27.1')
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '26.0'
      if target.name == 'foldable' && duo_sdk
        flags = Array(config.build_settings['OTHER_SWIFT_FLAGS'] || '$(inherited)')
        # Scope the define to this SDK so cached Pods also support older Xcodes.
        ['iphoneos', 'iphonesimulator'].each do |sdk|
          config.build_settings["OTHER_SWIFT_FLAGS[sdk=#{sdk}#{sdk_version}*]"] =
            flags | ['-D', 'FOLDABLE_NATIVE_API']
        end
      end

      # google_mobile_ads 9.1.0 imports GoogleMobileAds_Beta.h from the SDK's
      # private headers. Xcode 26 otherwise rejects that import while compiling
      # the plugin as a framework module.
      if target.name == 'google_mobile_ads'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end

    # Xcode 26.6 can kill the nested shell CocoaPods generates for XCFramework
    # copy phases. Source the generated script in the phase's existing shell so
    # the same script runs without spawning the process that gets SIGKILLed.
    target.shell_script_build_phases.each do |phase|
      next unless phase.name == '[CP] Copy XCFrameworks'

      script_path = phase.shell_script.strip
      phase.shell_path = '/bin/bash'
      phase.shell_script = "source #{script_path}\n"
    end
  end

  # webview_flutter_wkwebview 3.26.x can decode a detached authentication
  # challenge response as NSNull and then force-cast it, crashing the app.
  # Keep this local workaround until flutter/flutter#191254 is fixed upstream.
  webkit_generated_source = File.join(
    __dir__,
    '.symlinks',
    'plugins',
    'webview_flutter_wkwebview',
    'darwin',
    'webview_flutter_wkwebview',
    'Sources',
    'webview_flutter_wkwebview',
    'WebKitLibrary.g.swift'
  )
  if File.exist?(webkit_generated_source)
    source = File.read(webkit_generated_source)
    unsafe_cast = <<~'SWIFT'.strip
      let result = listResponse[0] as! AuthenticationChallengeResponse
              completion(.success(result))
    SWIFT
    safe_cast = <<~'SWIFT'.strip
      guard let result = listResponse[0] as? AuthenticationChallengeResponse else {
                completion(
                  .success(
                    AuthenticationChallengeResponse(
                      disposition: .performDefaultHandling,
                      credential: nil)))
                return
              }
              completion(.success(result))
    SWIFT
    if source.include?(unsafe_cast)
      File.write(webkit_generated_source, source.sub(unsafe_cast, safe_cast))
      Pod::UI.puts 'Patched WKWebView authentication challenge NSNull crash.'
    end
  end

  # Xcode 27 adds Foundation Models transcript cases that the current plugin
  # does not handle. Keep unknown entries readable until the plugin updates.
  foundation_models_source = File.join(
    __dir__, '.symlinks', 'plugins', 'foundation_models_framework', 'ios',
    'Classes', 'FoundationModelsFrameworkPlugin.swift'
  )
  if File.exist?(foundation_models_source)
    source = File.read(foundation_models_source)
    entry_case = /(?<body>            case \.response\(let response\):\n                role = "response"\n                segmentsText = response\.segments\.map\(serializeSegment\)\n                content = segmentsText\.joined\(separator: "\\n"\)\n)(?<end>            \})/
    segment_case = /(?<body>        case \.structure\(let structuredSegment\):\n            return String\(describing: structuredSegment\.content\)\n)(?<end>        \})/
    changed = false
    if source.match?(entry_case)
      source.sub!(entry_case) do
        "#{$~[:body]}            @unknown default:\n                role = \"unknown\"\n                let description = String(describing: entry)\n                segmentsText = [description]\n                content = description\n#{$~[:end]}"
      end
      changed = true
    end
    if source.match?(segment_case)
      source.sub!(segment_case) do
        "#{$~[:body]}        @unknown default:\n            return String(describing: segment)\n#{$~[:end]}"
      end
      changed = true
    end
    if changed
      File.write(foundation_models_source, source)
      Pod::UI.puts 'Patched Foundation Models transcript cases for Xcode 27.'
    end
  end
end
