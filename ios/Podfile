require_relative '../scripts/apple_plugin_compatibility'

# Uncomment this line to define a global platform for your project
platform :ios, '26.0'

unless system('/bin/sh', File.expand_path('../scripts/check_ios_toolchain.sh', __dir__))
  raise 'The selected iOS SDK does not meet this project\'s iPhone Duo build requirements.'
end

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Analytics and Messaging's latest CocoaPods releases are 12.19.0. The
# 12.19.3 patch only publishes selected pods; FlutterFire's common exact
# 12.19.3 pin cannot resolve every product. Keep the shared product version.
$FirebaseSDKVersion = '12.19.0'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
#   target 'RunnerTests' do
#     inherit! :search_paths
#   end
end

post_install do |installer|
  sdk_version = `xcrun --sdk iphoneos --show-sdk-version`.strip
  duo_sdk = Gem::Version.new(sdk_version) >= Gem::Version.new('27.1')
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '26.0'
      if target.name == 'foldable' && duo_sdk
        flags = Array(config.build_settings['OTHER_SWIFT_FLAGS'] || '$(inherited)')
        # Scope the define to this SDK so cached Pods also support older Xcodes.
        ['iphoneos', 'iphonesimulator'].each do |sdk|
          config.build_settings["OTHER_SWIFT_FLAGS[sdk=#{sdk}#{sdk_version}*]"] =
            flags | ['-D', 'FOLDABLE_NATIVE_API']
        end
      end

      # google_mobile_ads 9.1.0 imports GoogleMobileAds_Beta.h from the SDK's
      # private headers. Xcode 26 otherwise rejects that import while compiling
      # the plugin as a framework module.
      if target.name == 'google_mobile_ads'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end

    # Xcode 26.6 can kill the nested shell CocoaPods generates for XCFramework
    # copy phases. Source the generated script in the phase's existing shell so
    # the same script runs without spawning the process that gets SIGKILLed.
    target.shell_script_build_phases.each do |phase|
      next unless phase.name == '[CP] Copy XCFrameworks'

      script_path = phase.shell_script.strip
      phase.shell_path = '/bin/bash'
      phase.shell_script = "source #{script_path}\n"
    end
  end

  ApplePluginCompatibility.apply(
    installer,
    sdk_version: `xcrun --sdk iphoneos --show-sdk-version`.strip
  )
end
