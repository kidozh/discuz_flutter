platform :osx, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Analytics and Messaging's latest CocoaPods releases are 12.19.0. The
# 12.19.3 patch only publishes selected pods; FlutterFire's common exact
# 12.19.3 pin cannot resolve every product. Keep the shared product version.
$FirebaseSDKVersion = '12.19.0'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end

  # Match the iOS compatibility patch for new Xcode 27 transcript cases.
  foundation_models_source = File.join(
    __dir__, 'Flutter', 'ephemeral', '.symlinks', 'plugins',
    'foundation_models_framework', 'macos',
    'Classes', 'FoundationModelsFrameworkPlugin.swift'
  )
  if File.exist?(foundation_models_source)
    source = File.read(foundation_models_source)
    entry_case = /(?<body>            case \.response\(let response\):\n                role = "response"\n                segmentsText = response\.segments\.map\(serializeSegment\)\n                content = segmentsText\.joined\(separator: "\\n"\)\n)(?<end>            \})/
    segment_case = /(?<body>        case \.structure\(let structuredSegment\):\n            return String\(describing: structuredSegment\.content\)\n)(?<end>        \})/
    changed = false
    if source.match?(entry_case)
      source.sub!(entry_case) do
        "#{$~[:body]}            @unknown default:\n                role = \"unknown\"\n                let description = String(describing: entry)\n                segmentsText = [description]\n                content = description\n#{$~[:end]}"
      end
      changed = true
    end
    if source.match?(segment_case)
      source.sub!(segment_case) do
        "#{$~[:body]}        @unknown default:\n            return String(describing: segment)\n#{$~[:end]}"
      end
      changed = true
    end
    if changed
      File.write(foundation_models_source, source)
      Pod::UI.puts 'Patched Foundation Models transcript cases for Xcode 27.'
    end
  end
end
